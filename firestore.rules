rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsDocument() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function createsOwnDocument() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    function updatesOwnDocument() {
      return ownsDocument()
        && request.resource.data.userId == resource.data.userId;
    }

    function ownsClient(clientId) {
      return signedIn()
        && clientId is string
        && exists(/databases/$(database)/documents/clients/$(clientId))
        && get(/databases/$(database)/documents/clients/$(clientId)).data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isPremium() {
      return exists(userPath())
        && get(userPath()).data.get('premiumUntil', null) != null
        && get(userPath()).data.premiumUntil > request.time;
    }

    function underClientLimit() {
      return !exists(userPath())
        || get(userPath()).data.get('clientCount', 0) < 5;
    }

    // Hoy + 7 días en hora de Colombia (UTC-5). Citas guardadas a medianoche local.
    function freeWeekLimit() {
      let local = request.time - duration.value(5, 'h');
      let localMidnight = timestamp.date(local.year(), local.month(), local.day());
      return localMidnight + duration.value(8, 'd') + duration.value(5, 'h');
    }

    function withinPlanSchedule() {
      return isPremium() || request.resource.data.date < freeWeekLimit();
    }

    function validTime(t) {
      return t is string && t.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$');
    }

    function slotId(uid, dateKey, t) {
      return uid + '_' + dateKey + '_' + t.replace(':', '');
    }

    function slotIsOffered(uid, dateKey, t) {
      let path = /databases/$(database)/documents/availability/$(uid + '_' + dateKey);
      return exists(path) && get(path).data.times.hasAny([t]);
    }

    function isPremiumUser(uid) {
      let path = /databases/$(database)/documents/users/$(uid);
      return exists(path)
        && get(path).data.get('premiumUntil', null) != null
        && get(path).data.premiumUntil > request.time;
    }

    function profileAcceptsBookings(uid) {
      let path = /databases/$(database)/documents/bookingProfiles/$(uid);
      return exists(path) && get(path).data.enabled == true && isPremiumUser(uid);
    }

    // Reserva pública (cliente sin sesión): la cita y el bloqueo se escriben en el mismo lote.
    function isPublicBooking(appointmentId) {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'userId', 'clientName', 'clientPhone', 'service', 'date', 'dateKey', 'time',
          'price', 'paid', 'paymentStatus', 'notes', 'source', 'createdAt', 'updatedAt'
        ])
        && d.keys().hasAll([
          'userId', 'clientName', 'clientPhone', 'service', 'date', 'dateKey', 'time',
          'price', 'paid', 'paymentStatus', 'notes', 'source', 'createdAt', 'updatedAt'
        ])
        && d.userId is string && d.dateKey is string && validTime(d.time)
        && appointmentId == slotId(d.userId, d.dateKey, d.time)
        && d.source == 'online'
        && d.price == 0 && d.paid == 0 && d.paymentStatus == 'pendiente'
        && d.date is timestamp && d.createdAt is timestamp && d.updatedAt is timestamp
        && d.clientName is string && d.clientName.size() > 0 && d.clientName.size() <= 100
        && d.clientPhone is string && d.clientPhone.size() >= 7 && d.clientPhone.size() <= 30
        && d['service'] is string && d['service'].size() > 0 && d['service'].size() <= 100
        && d.notes == ''
        && profileAcceptsBookings(d.userId)
        && slotIsOffered(d.userId, d.dateKey, d.time)
        && existsAfter(/databases/$(database)/documents/slotLocks/$(appointmentId));
    }

    match /bookingProfiles/{profileId} {
      allow read: if true;
      allow create, update: if signedIn()
        && isPremium()
        && profileId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.businessName is string
        && request.resource.data.businessName.size() <= 100
        && request.resource.data.enabled is bool
        && request.resource.data.slotMinutes in [15, 20, 30, 45, 60, 90, 120]
        && request.resource.data.services is list
        && request.resource.data.services.size() <= 30;
      allow delete: if signedIn() && profileId == request.auth.uid;
    }

    match /availability/{availabilityId} {
      allow read: if true;
      allow create, update: if createsOwnDocument()
        && isPremium()
        && availabilityId == request.auth.uid + '_' + request.resource.data.dateKey
        && request.resource.data.times is list
        && request.resource.data.times.size() <= 100;
      allow delete: if ownsDocument();
    }

    match /slotLocks/{lockId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['userId', 'dateKey', 'time'])
        && validTime(request.resource.data.time)
        && lockId == slotId(request.resource.data.userId, request.resource.data.dateKey, request.resource.data.time)
        && profileAcceptsBookings(request.resource.data.userId)
        && slotIsOffered(request.resource.data.userId, request.resource.data.dateKey, request.resource.data.time)
        && existsAfter(/databases/$(database)/documents/appointments/$(lockId));
      allow update: if false;
      allow delete: if ownsDocument();
    }

    match /appointments/{appointmentId} {
      allow read: if ownsDocument();
      allow create: if (createsOwnDocument() && withinPlanSchedule()) || isPublicBooking(appointmentId);
      allow update: if updatesOwnDocument() && withinPlanSchedule();
      allow delete: if ownsDocument();
    }

    match /clients/{clientId} {
      allow read: if ownsDocument();
      allow create: if createsOwnDocument() && (isPremium() || underClientLimit());
      allow update: if updatesOwnDocument();
      allow delete: if ownsDocument();
    }

    match /clientServices/{serviceId} {
      allow read: if ownsDocument();
      allow create: if createsOwnDocument();
      allow update: if updatesOwnDocument();
      allow delete: if ownsDocument();
    }

    match /clientPayments/{paymentId} {
      allow read: if ownsDocument();
      allow create: if createsOwnDocument();
      allow update: if updatesOwnDocument();
      allow delete: if ownsDocument();
    }

    match /payments/{paymentId} {
      allow read: if ownsDocument();
      allow create: if createsOwnDocument();
      allow update: if updatesOwnDocument();
      allow delete: if ownsDocument();
    }

    match /products/{productId} {
      allow read: if ownsDocument();
      allow create: if createsOwnDocument();
      allow update: if updatesOwnDocument();
      allow delete: if ownsDocument();
    }

    match /sales/{saleId} {
      allow read: if ownsDocument();
      allow create: if createsOwnDocument();
      allow update: if updatesOwnDocument();
      allow delete: if ownsDocument();
    }

    match /specialDays/{specialDayId} {
      allow read: if ownsDocument();
      allow create: if createsOwnDocument();
      allow update: if updatesOwnDocument();
      allow delete: if ownsDocument();
    }

    match /notes/{noteId} {
      allow read: if ownsDocument();
      allow create: if createsOwnDocument();
      allow update: if updatesOwnDocument();
      allow delete: if ownsDocument();
    }

    match /clientConsents/{consentId} {
      allow read: if ownsDocument();
      allow create: if createsOwnDocument();
      allow update: if updatesOwnDocument();
      allow delete: if ownsDocument();
    }

    match /clientPhotos/{photoId} {
      allow read: if ownsDocument();
      allow create: if createsOwnDocument()
        && ownsClient(request.resource.data.clientId)
        && request.resource.data.keys().hasAll([
          'userId', 'clientId', 'clientName', 'imageUrl', 'storagePath',
          'date', 'notes', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'userId', 'clientId', 'clientName', 'imageUrl', 'storagePath',
          'date', 'notes', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.clientName is string
        && request.resource.data.clientName.size() <= 200
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 2048
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.matches(
          'client-photos/' + request.auth.uid + '/' + request.resource.data.clientId + '/.*'
        )
        && request.resource.data.date is timestamp
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 500
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if ownsDocument()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.imageUrl == resource.data.imageUrl
        && request.resource.data.storagePath == resource.data.storagePath
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'date', 'notes', 'updatedAt'
        ])
        && request.resource.data.date is timestamp
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 500
        && request.resource.data.updatedAt is timestamp;
      allow delete: if ownsDocument();
    }
  }
}
